#!/data/data/com.termux/files/usr/bin/bash

set -e

echo "[*] Using Python 3.11..."

# --- create clean env ---
python3.11 -m venv venv
source venv/bin/activate

echo "[*] Upgrading pip..."
pip install --upgrade pip

# --- write workflow ---
echo "[*] Writing GitHub Actions workflow..."

mkdir -p .github/workflows

cat > .github/workflows/build.yml << 'EOF'
name: build-pydantic-android

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Setup Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install Rust + target
        run: rustup target add aarch64-linux-android

      - name: Install deps
        run: |
          pip install maturin
          sudo apt-get update
          sudo apt-get install -y gcc-aarch64-linux-gnu

      - name: Download source
        run: pip download pydantic-core --no-binary=:all:

      - name: Build wheel
        run: |
          export PYO3_CROSS=1
          export PYO3_CROSS_PYTHON_VERSION=3.11
          tar -xf pydantic_core-*.tar.gz
          DIR=$(ls -d pydantic_core-* | head -n 1)
          cd "$DIR"
          maturin build --release --target aarch64-linux-android --skip-auditwheel -vv

      - name: Upload wheel
        uses: actions/upload-artifact@v4
        with:
          name: wheel
          path: pydantic_core-*/target/wheels/*.whl
EOF

# --- push workflow ---
echo "[*] Pushing workflow..."
git add .
git commit -m "final python 3.11 build pipeline" || echo "[*] No changes"
git push

# --- trigger build ---
echo "[*] Triggering build..."
gh workflow run build.yml

sleep 5
RUN_ID=$(gh run list --limit 1 --json databaseId -q '.[0].databaseId')

echo "[*] Watching build..."
gh run watch $RUN_ID

# --- download artifact ---
echo "[*] Downloading artifact..."
gh run download $RUN_ID

# --- install wheel ---
echo "[*] Installing built wheel..."
pip install pydantic_core-*.whl
pip install pydantic

# --- verify ---
echo "[*] Verifying install..."
python - << 'PY'
import pydantic
print("Pydantic version:", pydantic.__version__)
PY

echo "[*] DONE ✅"
